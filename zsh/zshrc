fpath=($HOME/.zsh/prezto-themes $fpath)
export JAVA_HOME="/opt/homebrew/opt/openjdk@21"
export ANDROID_HOME="$HOME/Library/Android/sdk"
export PATH=/opt/homebrew/bin:/opt/homebrew/opt/openjdk@21/bin:$ANDROID_HOME/emulator:$ANDROID_HOME/platform-tools:$ANDROID_HOME/cmdline-tools/latest/bin:$PATH
alias 'vim'='nvim'   # nvim is the daily driver; use 'command vim' for legacy vim

# Terminal
# Use xterm-256color (for tmux, too)
export TERM="xterm-256color"

# Source Prezto.
if [[ -s "${ZDOTDIR:-$HOME}/.zprezto/init.zsh" ]]; then
  source "${ZDOTDIR:-$HOME}/.zprezto/init.zsh"
fi

# Additional  from ~/.zshrc.local
if [[ -s "${ZDOTDIR:-$HOME}/.zshrc.local" ]]; then
  source "${ZDOTDIR:-$HOME}/.zshrc.local"
fi

# Customize to your needs...
for config_file ($HOME/.zsh/zsh.d/*.zsh) source $config_file

#source $HOME/.LS_COLORS/ls_colors.zsh

[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh

test -e "${HOME}/.iterm2_shell_integration.zsh" && source "${HOME}/.iterm2_shell_integration.zsh"

export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion

# The next line updates PATH for the Google Cloud SDK.
if [ -f '/Users/muzi/Downloads/google-cloud-sdk/path.zsh.inc' ]; then . '/Users/muzi/Downloads/google-cloud-sdk/path.zsh.inc'; fi

# The next line enables shell command completion for gcloud.
if [ -f '/Users/muzi/Downloads/google-cloud-sdk/completion.zsh.inc' ]; then . '/Users/muzi/Downloads/google-cloud-sdk/completion.zsh.inc'; fi

eval $(thefuck --alias)
# The following lines have been added by Docker Desktop to enable Docker CLI completions.
fpath=(/Users/muzi/.docker/completions $fpath)
autoload -Uz compinit
compinit
# End of Docker CLI completions
#
#
#
load-nvmrc() {
  local node_version="$(nvm version)"
  local nvmrc_path="$(nvm_find_nvmrc)"

  if [ -n "$nvmrc_path" ]; then
    local nvmrc_node_version=$(cat "$nvmrc_path")

    if [ "$nvmrc_node_version" != "$node_version" ]; then
      nvm use
    fi
  fi
}

add-zsh-hook chpwd load-nvmrc
load-nvmrc

alias ba='npm run build-all'
alias rd='npm run dev'
alias rdr='npm run dev-real'
alias clc='claude --dangerously-skip-permissions '
alias cls='clc --model sonnet'
alias claude='claude --dangerously-skip-permissions'
alias codex='codex --dangerously-bypass-approvals-and-sandbox'

# cmux's shell integration unaliases `claude` and installs its own
# `claude()` function (rebuilt again by _cmux_fix_path on the first prompt),
# which drops --dangerously-skip-permissions. Rather than fight that function,
# wrap the dispatcher it always calls, `_cmux_claude_wrapper_command`. cmux
# defines that dispatcher once (during .zshenv, before this file) and never
# rebuilds it, so wrapping it here survives every claude() rebuild and needs no
# precmd hook. We must NOT redefine `claude()` directly here: with the alias
# above still active, `claude() { ... }` triggers alias expansion at parse time
# and errors ("parse error near '()'"), which is what silently broke the old
# precmd approach. No-op outside cmux (dispatcher absent), where the alias
# already applies the flag; idempotent and safe to re-source.
if typeset -f _cmux_claude_wrapper_command >/dev/null 2>&1 \
   && ! typeset -f _muzi_orig_cmux_claude_wrapper >/dev/null 2>&1; then
  functions[_muzi_orig_cmux_claude_wrapper]=$functions[_cmux_claude_wrapper_command]
  _cmux_claude_wrapper_command() {
    local arg
    for arg in "$@"; do
      if [[ "$arg" == "--dangerously-skip-permissions" ]]; then
        _muzi_orig_cmux_claude_wrapper "$@"
        return
      fi
    done
    _muzi_orig_cmux_claude_wrapper --dangerously-skip-permissions "$@"
  }
fi

# opencode
export PATH=/Users/muzi/.opencode/bin:$PATH
export EDITOR=nvim
export VISUAL=nvim
# local-only secrets (gitignored, never committed) — see zsh/secrets.local.zsh
[ -f ~/.zsh/secrets.local.zsh ] && source ~/.zsh/secrets.local.zsh

# mise
eval "$(/opt/homebrew/bin/mise activate zsh)"
